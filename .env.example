# Copy to .env and fill in. Never commit .env.

# Crustdata
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# sim = in-process simulator, no key needed, no credits spent
# live = real API; record = real API and save responses; replay = saved responses only
CRUSTDATA_MODE=sim

# Claude. Without a key the rules classifier runs instead.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Only for a key not scoped to a workspace. Otherwise leave it empty.
ANTHROPIC_WORKSPACE_ID=

# Which vendor the agent works for: a file in app/personas/
VENDOR_PERSONA=crustdata
# basic, or react to get profile reports from build_report in app/pipeline/react_profiles.py
PROFILE_BUILDER=basic
# true: a clear name match skips the agent and takes about 15 s. false: the agent runs on everyone.
FAST_PATH=true
# Seconds for one agent run, from when its turn starts. One agent runs at a time.
PROFILE_TIMEOUT_S=240

# Email (Resend). Real sends happen only when EMAIL_LIVE=true and the address is allowlisted.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_LIVE=false
# Comma-separated addresses. Event rules: only our team and the organisers, so never use *
EMAIL_ALLOWLIST=
# Test on real people's profiles without emailing them: every send goes here. Must be on the allowlist.
EMAIL_REDIRECT_TO=

# Slack incoming webhook for sales briefs. Real posts happen only when SLACK_LIVE=true.
SLACK_WEBHOOK_URL=
SLACK_LIVE=false

# Base URL used in sandbox links
APP_BASE_URL=http://localhost:8000

# Basic auth for the dashboard (user: demo). Empty disables it; set it on any public host.
DEMO_PASSWORD=

# Stops all paid Crustdata calls once this many credits have been spent in total
GLOBAL_CREDIT_CAP=2000

# Founder watch: founders and CEOs of startups get a Crustdata watch on their profile and company.
# On the real API each change costs 5 credits, so watches are only planned until WATCH_LIVE=true.
WATCH_FOUNDERS=true
WATCH_LIVE=false
# How often we read new watch runs, in seconds. 0 leaves it to the dashboard's "Check watches now".
WATCH_POLL_S=3600
